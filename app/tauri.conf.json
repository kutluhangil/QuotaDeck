{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Deck",
  "version": "1.0.0",
  "identifier": "com.kutluhangil.quotadeck",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "panel",
        "title": "Quota Deck",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Local quota tracking for AI coding tools",
    "longDescription": "Quota Deck reads the session logs that AI coding tools already write to your disk and shows how much of each rolling quota window is used. No account, no login, no network requests.",
    "copyright": "Kutluhan Gil",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
