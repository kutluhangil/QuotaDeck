<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The store build's entitlements: everything in `Entitlements.plist` plus the two keys that tie
  the binary to one developer account. Xcode injects these automatically; a manual `codesign`
  has to state them, and Asset Validation rejects the upload if they disagree with the
  provisioning profile.

  `$TEAM_ID` is substituted by `scripts/appstore.sh` into a temporary copy. It is left as a
  placeholder here because a Team ID is account data, not source, and belongs in the
  environment rather than in the repository.

  Kept as a separate file rather than generated from scratch so the sandbox regression test can
  sign against the plain `Entitlements.plist` — the same sandbox, without needing an account.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>$TEAM_ID.com.kutluhangil.quotadeck</string>
  <key>com.apple.developer.team-identifier</key>
  <string>$TEAM_ID</string>
</dict>
</plist>
