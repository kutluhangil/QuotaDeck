<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Sandbox, and the two capabilities the app actually uses.

  What is absent is the point. There is no outbound-connection capability, because the app makes
  no requests: the privacy claim in the store listing is enforced by the code signature rather
  than asserted in prose. There is no home-relative temporary exception either — those are a
  documented App Review rejection, and the user-selected grant below is the sanctioned route.

  `files.user-selected.read-only` is what the folder panel hands us, and
  `files.bookmarks.app-scope` is what lets that grant survive a relaunch. Read-only on purpose:
  the app never writes outside its own container. The one exception, the opt-in Claude Code
  statusline shim, is a separate consent and does not belong to this build.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
</dict>
</plist>
